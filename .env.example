# Copy to .env (local) or add in Vercel -> Settings -> Environment Variables.
# Leave DATABASE_URL empty to use a local SQLite file.
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SECRET_KEY=change-me-to-a-long-random-string

# AI: gemini | sarvam | sarvam_flash | openai_compat | mock (offline tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.5-flash-lite
SARVAM_API_KEY=

# Owner-only code for publishing evaluation results to every visitor
PUBLISH_CODE=
